<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_PTP" Id="{0b7cd14e-b03a-491a-b09a-60e7c46dba99}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_PTP
VAR
    fbPersistentDataStorage : LCLS_Tc_DevAbs.FB_PersistentDataStorage;
	{attribute 'pytmc' := '
		axis-link: GVL_Axes.Axes[1]
		pv: TST:MOTION:HT23
	'}
    {attribute 'TcLinkTo' := '.fbEncoderScaling.nRawEncoderULINT  := TIIB[EL5042_E2]^FB Inputs Channel 1^Position
	'}
   	fbptpht23 : FB_MotionStageNC(	
		sName := 'HT23',
        AxisRef := GVL_Axes.Axes[1],
        iPersistentDataStorage := fbPersistentDataStorage
	) ;
	{attribute 'pytmc' := '
		axis-link: GVL_Axes.Axes[2]
		pv: TST:MOTION:SO23HS
	'}
    {attribute 'TcLinkTo' := '.fbLimSwStatus.bLimitBwd := TIIB[EL7047_E5]^STM Status^Status^Digital input 1;
                              .fbEncoderScaling.nRawEncoderUDINT  := TIIB[EL5101_E3]^ENC Status compact^Counter value
	'}
   	fbPtpso23hs : FB_MotionStageNC(	
		sName := 'SO23HS',
        AxisRef := GVL_Axes.Axes[2],
        iPersistentDataStorage := fbPersistentDataStorage
	) ;
	bFirstScan: BOOL := TRUE;
    {attribute 'pytmc' := '
		pv: TST:MOTION:SO23HS:SIM:Enable
		io: io
	'}
	bSimEnable : BOOL;
    {attribute 'pytmc' := '
		pv: TST:MOTION:SO23HS:SIM:HomeLo
		io: io
	'}
	fSimHomeLo : LREAL := 10.0;
    {attribute 'pytmc' := '
		pv: TST:MOTION:SO23HS:SIM:HomeHi
		io: io
	'}
	fSimHomeHi : LREAL := 15.0;
    {attribute 'pytmc' := '
		pv: TST:MOTION:SO23HS:SIM:Searches
		io: i
	'}
	nSearches : INT;
    {attribute 'pytmc' := '
		pv: TST:MOTION:SO23HS:SIM:HitFwd
		io: i
	'}
	bHitFwd : BOOL;
    {attribute 'pytmc' := '
		pv: TST:MOTION:SO23HS:SIM:HitHome
		io: i
	'}
	bHitHome : BOOL;
	fSimPos, fLastPos : LREAL;
	bSearching, bHomeFirst, bSimWas, bPulse : BOOL;
	rtSearching : R_TRIG;
	fbTravel, fbPulseLen : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bFirstScan THEN
    fbptpht23.SetModeEnableLimits(
        LimBackward := TRUE,
        LimForward := TRUE,
        HomeEnable  := FALSE,
        BrakeMode   := E_StageBrakeMode.IF_ENABLED,
        EnableMode  := E_StageEnableMode.DURING_MOTION,
        HomeMode    := 1,
        UserEnable  := TRUE,
        HardwareEnable := TRUE
    );
    fbptpht23.SetVelocity(
        Velocity     := 1.0
    );
	fbPtpso23hs.SetModeEnableLimits(
        LimBackward := TRUE,
        LimForward := TRUE,
        HomeEnable  := FALSE,
        BrakeMode   := E_StageBrakeMode.IF_ENABLED,
        EnableMode  := E_StageEnableMode.DURING_MOTION,
        HomeMode    := E_EpicsHomeCmd.LOW_LIMIT,
        UserEnable  := TRUE,
        HardwareEnable := TRUE
    );
    fbPtpso23hs.SetVelocity(
        Velocity     := 1.0
    );
    bFirstScan := FALSE;
END_IF

fbptpht23();
fbPtpso23hs();
fSimPos := fbPtpso23hs.MotionStatus.fActPosition;
bSearching := bSimEnable AND ABS(fSimPos) > 1.0E9;
rtSearching(CLK := bSearching);
IF rtSearching.Q THEN
    nSearches := nSearches + 1;
END_IF
IF NOT bSearching THEN
    fLastPos := fSimPos;
    IF NOT fbPtpso23hs.MotionStatus.bBusy THEN
        nSearches := 0;
    END_IF
END_IF
fbTravel(IN := bSearching, PT := T#1500MS);
fbPulseLen(IN := fbTravel.Q, PT := T#2S);
bPulse := fbTravel.Q AND NOT fbPulseLen.Q;
bHitFwd := FALSE;
bHitHome := FALSE;
IF bSearching THEN
    CASE fbPtpso23hs.HomeMode OF
        E_EpicsHomeCmd.HIGH_LIMIT:
            bHitFwd := bPulse;
        E_EpicsHomeCmd.HOME_VIA_LOW:
            bHomeFirst := fLastPos > fSimHomeHi;
            IF nSearches > 1 OR bHomeFirst THEN
                bHitHome := bPulse;
            END_IF
        E_EpicsHomeCmd.HOME_VIA_HIGH:
            bHomeFirst := fLastPos < fSimHomeLo;
            IF nSearches <= 1 AND NOT bHomeFirst THEN
                bHitFwd := bPulse;
            ELSE
                bHitHome := bPulse;
            END_IF
    END_CASE
END_IF
IF bSimEnable THEN
    fbPtpso23hs.EnableLimits(ForwardEnable := NOT bHitFwd, BackwardEnable := TRUE, HomeEnable := bHitHome);
ELSIF bSimWas THEN
    fbPtpso23hs.EnableLimits(ForwardEnable := TRUE, BackwardEnable := TRUE, HomeEnable := FALSE);
END_IF
bSimWas := bSimEnable;
fbPersistentDataStorage();]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>