  field(ZNAM, "FALSE")
  field(ONAM, "TRUE")
  info(autosaveFields_pass0, "DESC DISS OSV SIMS UDFS ZSV")
  info(archive, "VAL")
  field(ASG, "NO_WRITE")
}

